@startuml classes

abstract class DefaultEntity <<MappedSuperclass>> {
  - id: Long
  - dataCadastro: LocalDateTime
  - dataAtualizacao: LocalDateTime
}

note bottom of DefaultEntity
  Todas as classes do domínio
  herdam de DefaultEntity
end note

enum TipoMissa {
  COMUM
  DOMINICAL
  ESPECIAL
}

enum Perfil {
  SUPER_ADMIN
  ADMIN_PASTORAL
  PADRE
}

enum StatusConvocacao {
  PENDENTE
  CONFIRMADO
  EXPIRADO
  INVALIDADO
}

class Membro {
  - nomeCompleto: String
  - dataNascimento: LocalDate
  - telefone: String
  - nomeResponsavel: String
  - telefoneResponsavel: String
  - ativo: boolean
  - anonimizado: boolean
  - dataAnonimizacao: LocalDateTime
}

class Pastoral {
  - nome: String
  - descricao: String
  - ativo: boolean
}

class ConfiguracaoEscalonamento {
  - ordemConvocacaoReforco: Integer
  - intervaloMinutosEscalonamento: Integer
}

class Funcao {
  - nome: String
  - descricao: String
  - ativo: boolean
  - somenteSolene: boolean
  - tiposMissaPermitidos: Set<TipoMissa>
}

class MissaRecorrente {
  - diaSemana: DayOfWeek
  - horario: LocalTime
  - tipo: TipoMissa
  - ativo: boolean
}

class Missa {
  - dataHora: LocalDateTime
  - tipo: TipoMissa
  - solene: boolean
  - cancelada: boolean
}

class Escala {
}

class FormularioDisponibilidade {
  - mesReferencia: YearMonth
  - linkGoogleForms: String
  - dataAbertura: LocalDateTime
  - dataFechamento: LocalDateTime
  - minimoMissasMensal: Integer
}

class Disponibilidade {
  - observacoes: String
}

class ConvocacaoReforco {
  - token: String
  - status: StatusConvocacao
  - onda: int
  - dataEnvio: LocalDateTime
  - dataResposta: LocalDateTime
  - dataExpiracao: LocalDateTime
}

class Usuario {
  - keycloakId: String
  - ativo: boolean
}

class UsuarioPerfil {
  - perfil: Perfil
}

Membro "0..*" -- "0..*" Pastoral
Membro "0..*" -- "0..*" Funcao
Funcao "0..*" -- "0..*" Pastoral

Pastoral "1" --> "0..1" ConfiguracaoEscalonamento
Pastoral "1" --> "0..*" ConvocacaoReforco : onda de

Missa "1" --> "0..*" Escala
Membro "0..1" --> "0..*" Escala
Funcao "1" --> "0..*" Escala

MissaRecorrente "1" --> "0..*" Missa : gera

Pastoral "1" --> "0..*" FormularioDisponibilidade
FormularioDisponibilidade "1" --> "0..*" Disponibilidade
Membro "1" --> "0..*" Disponibilidade
Disponibilidade "0..*" -- "0..*" MissaRecorrente : disponível para

Escala "1" --> "0..*" ConvocacaoReforco : vaga em aberto
Membro "1" --> "0..*" ConvocacaoReforco : candidato

Membro "0..1" -- "0..1" Usuario : vinculado a

Usuario "1" --> "0..*" UsuarioPerfil
UsuarioPerfil "0..*" --> "0..1" Pastoral : escopo (se Admin Pastoral)

Missa --> TipoMissa
MissaRecorrente --> TipoMissa
Funcao --> TipoMissa
UsuarioPerfil --> Perfil
ConvocacaoReforco --> StatusConvocacao

@enduml
